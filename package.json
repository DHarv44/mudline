{
  "name": "mudline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "server": "npm run build:server && node dist-server/server.js",
    "start": "node dist-server/server.js",
    "typecheck": "tsc --noEmit",
    "app": "vite build && electron ."
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.1.0",
    "@fontsource/rajdhani": "^5.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "electron": "^33.2.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
